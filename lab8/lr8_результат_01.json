 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    #raise NotImplementedError('напишіть турнірний відбір')\n    choises = (rng.choice(len(F),k))\n    #print(F,choises,np.argmin(F[choises]))\n    return int(choises[np.argmin(F[choises])])\n    \"\"\"\n\n    minimal_l = max(F)\n    min_ind\n    for choise in choises:\n        if F[choise] <=minimal_l:\n    \"\"\"\n",
  "ox": "def ox(p1, p2, i, j):\n    #raise NotImplementedError('напишіть OX')\n    res = [-1]*len(p1)\n    for s in range(i,j+1):\n        res[s] = p1[s]\n    already_in_child = set(res[i : j + 1])\n    p2_circle = list(p2[j + 1 :]) + list(p2[: j + 1])\n\n    # 3. Залишаємо тільки ті гени, яких ще немає в нащадку\n    genes_to_insert = iter([g for g in p2_circle if g not in already_in_child])\n    e =(j + 1) % len(res)\n    while -1 in res:\n        if res[e] == -1:\n            res[e] = next(genes_to_insert)\n        e=(e+1)%len(res)\n    return res\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    # Векторне обчислення привабливості для всіх доступних міст одразу\n    w = (tau[cur, left] ** alpha) * (eta[cur, left] ** beta)\n    total = w.sum()\n\n    # Якщо всі ваги нульові (через сильне випаровування), обираємо рівноймовірно\n    if total <= 0:\n        return int(rng.choice(left))\n\n    probs = w / total\n    return int(rng.choice(left, p=probs))\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    tau *= (1.0 - rho)  # випаровування на місці без зайвого копіювання масиву\n    for tour, L in zip(tours, lens):\n        full_tour = np.concatenate(([0], tour, [0]))\n        # Векторне поповнення феромону для всіх ребер маршруту одночасно\n        tau[full_tour[:-1], full_tour[1:]] += 1.0 / L\n    return tau\n"
 },
